# PlayChale API settings for production. On the server: copy to .env.api, fill in, chmod 600.
# Each name is a setting from application.yml (PLAYCHALE_SECRET is playchale.secret, and so on).
# The API refuses to start if a required one is missing or still a laptop value, and says which.

# --- Database (Supabase) ------------------------------------------------------------------------
# Supabase → your project → Connect → "Session pooler" (port 5432, works over IPv4). Not the direct
# connection (IPv6 only) or the transaction pooler (6543), which breaks the API's locks.
# Supabase shows it as postgresql://USER:PASSWORD@HOST:5432/postgres; Java wants the three parts:
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.YOUR_PROJECT_REF
SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD
# Connections the API keeps open. Plenty for now, and well under the pooler's limit.
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5

# --- The API's own settings ---------------------------------------------------------------------
# Generate with: openssl rand -hex 32. Keep it: changing it voids sign-in codes already sent.
PLAYCHALE_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_32
# The web app's address. The first (only) one is also used for links and the logo in emails.
PLAYCHALE_CORS_ORIGINS=https://playchale.com

# --- Payments -----------------------------------------------------------------------------------
# Players pay the host directly (mobile money or cash) until Paystack is set up. Then set this to
# true and add PLAYCHALE_PAYSTACK_SECRET_KEY.
PLAYCHALE_PAYMENTS_IN_APP=false
PLAYCHALE_PAYMENTS_WEB_APP_URL=https://playchale.com

# --- Email (Resend) -----------------------------------------------------------------------------
# Sign-in codes by email. Resend → API Keys → create one with "Sending access" for playchale.com.
PLAYCHALE_RESEND_API_KEY=re_your_resend_api_key
# Must be on a domain verified in Resend (Resend → Domains).
PLAYCHALE_RESEND_FROM="PlayChale <alert@playchale.com>"
