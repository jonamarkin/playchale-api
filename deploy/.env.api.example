# PlayChale API settings for production. On the server: copy to .env.api, fill in, chmod 600.
# Each name is a setting from application.yml (PLAYCHALE_SECRET is playchale.secret, and so on).
# The API refuses to start if a required one is missing or still a laptop value, and says which.

# --- Database (Supabase) ------------------------------------------------------------------------
# Supabase → your project → Connect → "Session pooler" (port 5432, works over IPv4). Not the direct
# connection (IPv6 only) or the transaction pooler (6543), which breaks the API's locks.
# Supabase shows it as postgresql://USER:PASSWORD@HOST:5432/postgres; Java wants the three parts:
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.YOUR_PROJECT_REF
SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD
# Connections the API keeps open. Each page runs its queries one after another on one of these, so
# this caps how many requests are served at once: 10 managed about 85 a second in testing, so 5
# allows roughly half that.
# In session mode Supabase's pooler allows its "Pool Size" (Database → Settings → Connection pooling,
# about 15 on the free plan); 12 leaves room for the nightly backup and the dashboard. Raise both
# together on a bigger plan.
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=12

# --- The API's own settings ---------------------------------------------------------------------
# Generate with: openssl rand -hex 32. Keep it: changing it voids sign-in codes already sent.
PLAYCHALE_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_32
# The web apps allowed to call the API, comma-separated: the player app, then the admin desk (a
# separate app on its own subdomain). Keep the player app FIRST: the first one is also used for
# links and the logo in emails, and those must never point players at the admin desk.
PLAYCHALE_CORS_ORIGINS=https://playchale.com,https://admin.playchale.com

# --- Payments -----------------------------------------------------------------------------------
# Players pay the host directly (mobile money or cash) until Paystack is set up. Then set this to
# true and add PLAYCHALE_PAYSTACK_SECRET_KEY.
PLAYCHALE_PAYMENTS_IN_APP=false
PLAYCHALE_PAYMENTS_WEB_APP_URL=https://playchale.com

# --- Email (Resend) -----------------------------------------------------------------------------
# Sign-in codes by email. Resend → API Keys → create one with "Sending access" for playchale.com.
PLAYCHALE_RESEND_API_KEY=re_your_resend_api_key
# Must be on a domain verified in Resend (Resend → Domains).
PLAYCHALE_RESEND_FROM="PlayChale <alert@playchale.com>"

# --- SMS (Rancard) ----------------------------------------------------------------------------------
# Optional: sign-in codes by text, which turns on signing in with a phone number. Leave the key empty
# and people sign in by email only. unify.rancard.com → API key; the sender ID must be created there
# and approved by Rancard Support first (up to 11 characters).
PLAYCHALE_RANCARD_API_KEY=
PLAYCHALE_RANCARD_SENDER_ID=PlayChale
# The admin desk shows the SMS credits left; below this the API also logs a warning.
PLAYCHALE_RANCARD_LOW_BALANCE=500

# --- Maps (Google) ---------------------------------------------------------------------------------
# Optional: a server key with only the Places API (New) on it, restricted to this server's IP address.
# Places picked from the map search are looked up again with it before Google's 30-day limit on
# keeping their coordinates. Empty: those coordinates are cleared at 29 days instead (the place stays,
# so directions still work). The web app has its own browser key (NUXT_PUBLIC_GOOGLE_MAPS_KEY).
PLAYCHALE_GOOGLE_MAPS_KEY=

# --- Phone notifications (Web Push) ---------------------------------------------------------------
# Optional: leave both empty and notifications stay in the app only. Generate the pair once, on
# any computer with Node: npx web-push generate-vapid-keys. Keep them: changing them means every
# phone has to turn notifications on again. The private key is a secret.
PLAYCHALE_PUSH_VAPID_PUBLIC_KEY=
PLAYCHALE_PUSH_VAPID_PRIVATE_KEY=

# Sign in with Google: the web app's OAuth client ID from Google Cloud (public, not a secret).
# Leave empty to hide the Google button.
PLAYCHALE_GOOGLE_CLIENT_ID=
