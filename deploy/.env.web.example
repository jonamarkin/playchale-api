# PlayChale web app settings for production. On the server: copy to .env.web. Nothing here is
# secret: the browser receives all of it.

# Where the browser finds the API. Set, so the app uses the real API rather than its demo data.
NUXT_PUBLIC_API_BASE=https://api.playchale.com
# No "demo payment" wording on the live site.
NUXT_PUBLIC_DEMO_PAYMENTS=false
# Where the landing page's demo films are published (Cloudflare R2, bucket playchale-media).
NUXT_PUBLIC_MEDIA_BASE=https://media.playchale.com
# Optional: Google Maps in the app (searching for a place, the maps on venue, game and event pages,
# Discover's map). A browser key restricted to https://playchale.com/* with only the Maps JavaScript
# API, Places API (New) and Maps Embed API on it; see DEPLOYMENT.md, "Maps (Google)". Empty: no maps,
# and people paste a map link or use their location, as before.
NUXT_PUBLIC_GOOGLE_MAPS_KEY=
