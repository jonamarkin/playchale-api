# Copy to .env for local development: cp .env.example .env
# .env is ignored by git. Never commit real secrets.

PORT=8080
APP_ENV=development

# Matches compose.yaml. In production this comes from the managed Postgres provider.
DATABASE_URL=postgres://playchale:playchale@localhost:5432/playchale?sslmode=disable

# The web app's dev server. Comma-separate to allow more than one origin.
CORS_ORIGINS=http://localhost:3000
